{
  "name": "opencode-teamwork-v2",
  "version": "0.5.2",
  "description": "Antigravity-style multi-agent orchestration for OpenCode V2 — 11 agents, 7 commands, interactive model assignment on install.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "agents",
    "multi-agent",
    "orchestration",
    "teamwork",
    "deepseek"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorcnr/opencode-teamwork-v2.git"
  },
  "homepage": "https://github.com/sorcnr/opencode-teamwork-v2#readme",
  "bugs": {
    "url": "https://github.com/sorcnr/opencode-teamwork-v2/issues"
  },
  "type": "module",
  "exports": {
    ".": "./plugins/opencode-teamwork/index.ts"
  },
  "main": "./plugins/opencode-teamwork/index.ts",
  "bin": {
    "opencode-teamwork": "bin/opencode-teamwork.mjs",
    "opencode-teamwork-v2": "bin/opencode-teamwork.mjs"
  },
  "files": [
    "agents",
    "plugins",
    "lib",
    "bin",
    "docs",
    "scripts",
    "postinstall.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node ./postinstall.mjs",
    "lint:prompts": "node ./scripts/lint-prompts.mjs",
    "test:cost": "node ./scripts/test-cost.mjs",
    "test:engine": "node ./scripts/test-engine.mjs",
    "test": "npm run lint:prompts && npm run test:cost && npm run test:engine",
    "init": "node ./bin/opencode-teamwork.mjs init",
    "models": "node ./bin/opencode-teamwork.mjs models",
    "status": "node ./bin/opencode-teamwork.mjs status",
    "runs": "node ./bin/opencode-teamwork.mjs runs",
    "inspect": "node ./bin/opencode-teamwork.mjs inspect",
    "prune": "node ./bin/opencode-teamwork.mjs prune"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
